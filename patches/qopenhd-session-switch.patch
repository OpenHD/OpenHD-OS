+class OpenHDSessionKeyFilter final : public QObject {
+public:
+    explicit OpenHDSessionKeyFilter(QObject *window) : window(window) {}
+
+protected:
+    bool eventFilter(QObject *, QEvent *event) override {
+        if (event->type() != QEvent::KeyPress && event->type() != QEvent::KeyRelease)
+            return false;
+        const auto *key = static_cast<QKeyEvent *>(event);
+        if (key->key() != Qt::Key_Meta && key->key() != Qt::Key_Super_L && key->key() != Qt::Key_Super_R)
+            return false;
+        if (event->type() == QEvent::KeyRelease && !key->isAutoRepeat())
+            QMetaObject::invokeMethod(window, "switchOpenHDSession");
+        return true;
+    }
+
+private:
+    QObject *window;
+};
+
