[Unit]
Description=OpenHD desktop session
After=systemd-user-sessions.service
ConditionFileIsExecutable=/usr/bin/Hyprland
Conflicts=getty@tty2.service autovt@tty2.service

[Service]
Type=exec
ExecStartPre=/bin/sh -c 'printf "\\033[2J\\033[3J\\033[H\\033[?25l" >/dev/tty2'
ExecStart=/usr/sbin/greetd --config /etc/greetd/openhd.toml --vt 2
TimeoutStopSec=10
