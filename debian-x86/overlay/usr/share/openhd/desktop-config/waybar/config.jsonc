{
  "layer": "top",
  "position": "top",
  "height": 42,
  "margin-top": 14,
  "margin-left": 18,
  "margin-right": 18,
  "spacing": 6,
  "modules-left": ["custom/brand", "hyprland/workspaces", "custom/launcher", "wlr/taskbar"],
  "modules-center": ["clock"],
  "modules-right": ["tray", "network", "battery", "custom/keyboard", "custom/power"],
  "custom/brand": {"format": "◈  OPENHD", "tooltip": false},
  "hyprland/workspaces": {"format": "{id}", "on-click": "activate", "persistent-workspaces": {"*": 4}},
  "custom/launcher": {"format": "  Apps", "tooltip-format": "Applications · Super + Space", "on-click": "/usr/local/sbin/openhd-launcher"},
  "wlr/taskbar": {"format": "{icon}", "icon-size": 20, "tooltip-format": "{title}", "on-click": "activate", "on-click-middle": "close"},
  "clock": {"format": "{:%a  %d %b   ·   %H:%M}", "tooltip-format": "{:%A, %d %B %Y}"},
  "network": {"format-wifi": "  {signalStrength}%", "format-ethernet": "", "format-disconnected": "  —", "tooltip-format": "{ifname}: {ipaddr}", "on-click": "nm-connection-editor"},
  "battery": {"format": "{icon}  {capacity}%", "format-charging": "  {capacity}%", "format-icons": ["", "", "", "", ""], "states": {"warning": 25, "critical": 12}},
  "tray": {"icon-size": 17, "spacing": 12},
  "custom/keyboard": {"format": "", "tooltip-format": "On-screen keyboard", "on-click": "/usr/local/sbin/openhd-shell-action keyboard"},
  "custom/power": {"format": "", "tooltip-format": "Power", "on-click": "/usr/local/sbin/openhd-shell-action power"}
}
