#!/bin/sh
set -eu
if grep -qw openhd.mode=desktop /proc/cmdline && [ -x /usr/bin/Hyprland ]; then
    unset QT_QPA_PLATFORM QT_QPA_EGLFS_INTEGRATION QT_QPA_EGLFS_KMS_ATOMIC QOPENHD_X86_KMS QOPENHD_BOOT_ANIMATION
    unset QT_QPA_PLATFORM XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS DISPLAY WAYLAND_DISPLAY
    exec /usr/sbin/greetd --config /etc/greetd/openhd.toml --vt 1
fi
exec /usr/local/sbin/openhd-display
