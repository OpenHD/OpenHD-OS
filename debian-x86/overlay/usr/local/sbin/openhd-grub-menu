#!/bin/sh
# One generator for initial images and all subsequent Debian kernel updates.
set -eu
uuid=${1:-$(grub-probe --target=fs_uuid /)}
# Quiet the linux and initrd loading messages even when generated by update-grub.
printf 'set quiet_boot=1\n'
kernel=${2:-$(find /boot -maxdepth 1 -name 'vmlinuz-*' | sort -V | tail -1)}
kernel=${kernel#/boot/}
version=${kernel#vmlinuz-}
entry() {
    cat <<EOF
menuentry '$1' --id '$2' --class '$4' {
    search --no-floppy --fs-uuid --set=root $uuid
    linux /boot/$kernel root=UUID=$uuid rw rootflags=compress-force=zstd:6 console=tty3 quiet splash plymouth.use-simpledrm plymouth.ignore-serial-consoles loglevel=3 systemd.show_status=false rd.systemd.show_status=false logo.nologo vt.global_cursor_default=0 $3
    initrd /boot/initrd.img-$version
}
EOF
}
entry 'OpenHD' openhd '' minimal
echo "submenu 'Advanced options' --id openhd-advanced --class advanced {"
entry 'QOpenHD with compatible video' openhd-compatible 'openhd.video=gl' minimal
entry 'Maintenance console' openhd-console 'openhd.console systemd.show_status=true' advanced
echo '}'
