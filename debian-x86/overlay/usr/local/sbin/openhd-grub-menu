#!/bin/sh
# One generator for initial images and all subsequent Debian kernel updates.
set -eu
uuid=${1:-$(grub-probe --target=fs_uuid /)}
kernel=${2:-$(find /boot -maxdepth 1 -name 'vmlinuz-*' | sort -V | tail -1)}
kernel=${kernel#/boot/}
version=${kernel#vmlinuz-}
entry() {
    cat <<EOF
menuentry '$1' --id '$2' {
    search --no-floppy --fs-uuid --set=root $uuid
    linux /boot/$kernel root=UUID=$uuid rw rootflags=compress-force=zstd:6 console=tty3 quiet splash loglevel=3 vt.global_cursor_default=0 $3
    initrd /boot/initrd.img-$version
}
EOF
}
entry 'Start QOpenHD in minimal mode' openhd-minimal 'openhd.mode=minimal'
entry 'Start OpenHD-OS' openhd-desktop 'openhd.mode=desktop'
entry 'Install OpenHD minimal' openhd-install-minimal 'openhd.install openhd.profile=minimal'
entry 'Install OpenHD-OS' openhd-install-desktop 'openhd.install openhd.profile=desktop'
echo "submenu 'Advanced' --id openhd-advanced {"
entry 'QOpenHD with compatible video' openhd-compatible 'openhd.mode=minimal openhd.video=gl'
entry 'Maintenance console' openhd-console 'openhd.console'
echo '}'
