#!/bin/sh
# The desktop stays running on VT2. Only the foreground owns DRM scanout.
set -eu
[ "$(id -u)" = 0 ] || exit 1
state=/run/openhd-view
mkdir -p "$state"
exec 9>"$state/lock"
flock 9

set_view() {
    printf '%s\n' "$1" >"$state/current.new"
    mv -f "$state/current.new" "$state/current"
}

desktop() {
    [ -x /usr/bin/Hyprland ] || return 1
    uid=$(id -u openhd)
    # The subshell reads the running session's display, not the root caller's.
    # shellcheck disable=SC2016
    systemctl start openhd-desktop.service && chvt 2 &&
        timeout 18 sh -c '
            while :; do
                pid=$(pgrep -nx -u "$1" qs || true)
                if [ -n "$pid" ]; then
                    display=$(tr "\\0" "\\n" <"/proc/$pid/environ" | sed -n "s/^WAYLAND_DISPLAY=//p")
                    if [ -n "$display" ] && runuser -u openhd -- env XDG_RUNTIME_DIR="/run/user/$1" WAYLAND_DISPLAY="$display" \
                        qs ipc --pid "$pid" show 2>&1 |
                        grep -qiF "target desktop"; then exit 0; fi
                fi
                sleep 0.25
            done
        ' sh "$uid" && set_view desktop
}

flight() {
    desktop_session=$(loginctl show-seat seat0 -p ActiveSession --value 2>/dev/null || true)
    set_view switching
    chvt 1 || return 1
    # Let the logind-backed compositor finish releasing its seat and KMS.
    if [ -n "$desktop_session" ] &&
        [ "$(loginctl show-session "$desktop_session" -p VTNr --value)" = 2 ]; then
        # The session ID is positional in the child shell.
        # shellcheck disable=SC2016
        timeout 5 sh -c '
            while [ "$(loginctl show-session "$1" -p Active --value)" = yes ]; do
                sleep 0.1
            done
        ' sh "$desktop_session" || return 1
    fi
    # A failed DRM acquisition exits Qt; systemd retries while VT1 owns the seat.
    # shellcheck disable=SC2016
    systemctl start qopenhd.service &&
        timeout 12 sh -c '
            while :; do
                invocation=$(systemctl show qopenhd.service -p InvocationID --value)
                if [ -n "$invocation" ] &&
                    systemctl is-active --quiet qopenhd.service &&
                    journalctl -b --no-pager -o cat "_SYSTEMD_INVOCATION_ID=$invocation" |
                    grep -Fq "OpenHD flight view ready"; then
                    exit 0
                fi
                sleep 0.25
            done
        ' && set_view flight
}

installer() {
    printf '%s\n' "$1" >"$state/installer-return"
    set_view installer
    if ! systemctl stop qopenhd.service || ! chvt 1 || ! systemctl start openhd-installer.service; then
        rm -f "$state/installer-return"
        if [ "$1" = desktop ]; then desktop; else flight; fi
        return 1
    fi
}

case "${1:-}" in
    desktop|task-manager)
        if [ -x /usr/bin/Hyprland ]; then
            if ! desktop; then
                systemctl stop openhd-desktop.service
                flight
                exit 1
            fi
            if [ "$1" = task-manager ]; then
                uid=$(id -u openhd)
                pid=$(pgrep -nx -u "$uid" qs)
                display=$(tr '\0' '\n' <"/proc/$pid/environ" | sed -n 's/^WAYLAND_DISPLAY=//p')
                runuser -u openhd -- env XDG_RUNTIME_DIR="/run/user/$uid" WAYLAND_DISPLAY="$display" \
                    qs ipc --pid "$pid" call desktop taskManager
            fi
        else
            installer flight
        fi
        ;;
    flight)
        [ ! -e "$state/installer-return" ] || exit 1
        [ "$(cat "$state/current" 2>/dev/null)" = desktop ] || exit 1
        if ! flight; then
            systemctl stop qopenhd.service
            desktop
            exit 1
        fi
        ;;
    install)
        [ ! -e "$state/installer-return" ] || exit 1
        [ "$(cat "$state/current" 2>/dev/null)" = desktop ] || exit 1
        installer desktop
        ;;
    installer-return)
        [ -f "$state/installer-return" ] || exit 0
        destination=$(cat "$state/installer-return")
        rm -f "$state/installer-return"
        if [ "$destination" = desktop ] && desktop; then exit 0; fi
        flight
        ;;
    *) exit 2 ;;
esac
