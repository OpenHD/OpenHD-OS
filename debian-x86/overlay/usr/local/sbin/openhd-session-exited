#!/bin/sh
# Queue the next unit asynchronously so this unit can finish freeing its VT.
set -eu
case "${1:-}" in
    flight)
        if [ "${EXIT_CODE:-}" = exited ]; then
            case "${EXIT_STATUS:-}" in
                42) systemctl --no-block start openhd-switch-desktop.service ;;
                43) systemctl --no-block start openhd-show-task-manager.service ;;
            esac
        fi
        ;;
    installer)
        if [ -f /run/openhd-view/installer-return ]; then
            systemctl --no-block start openhd-return-from-installer.service
        fi
        ;;
esac
